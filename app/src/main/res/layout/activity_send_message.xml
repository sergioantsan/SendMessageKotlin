<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla de envío con un campo de texto y un botón estándar.

  Control de la barra de estado (edge-to-edge):
   - La Activity registra un listener de insets sobre @+id/main (raíz) que convierte
     las barras del sistema en padding: el contenido nunca se dibuja bajo la barra.
   - CoordinatorLayout como raíz respeta ese padding al medir y colocar a sus hijos,
     y deja hueco para añadir comportamientos (AppBarLayout, FAB) si hicieran falta.
   - El fondo queda en el raíz para cubrir también la zona de la barra
     (comportamiento esperado en edge-to-edge).
   - fitsSystemWindows="true" solo en el raíz como red de seguridad: si el listener
     no estuviera activo aplicaría el mismo padding. El listener tiene prioridad
     sobre fitsSystemWindows en la misma vista, así que nunca se duplica.
   - El LinearLayout interno no lleva fitsSystemWindows: los insets llegan sin
     consumir y el padding se duplicaría.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_large"
            android:gravity="center"
            android:text="@string/send_title"
            android:textColor="@color/title_color"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_medium"
            android:gravity="start|top"
            android:hint="@string/message_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3"
            android:padding="@dimen/component_padding"
            android:textColor="@color/body_text_color"
            android:textSize="@dimen/body_text_size" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_min_height"
            android:backgroundTint="@color/button_color"
            android:text="@string/send_button"
            android:textAllCaps="false"
            android:textColor="@color/button_text_color" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
